        "typeName": "Abilities",
        "characteristics": [
         {
          "name": "Description",
          "$text": "WHEN: Your Command phase.\nTARGET: One friendly ADEPTUS ASTARTES DREADNOUGHT unit.\nEFFECT: Until the start of your next Command phase, add 1 to that unit's Move, Toughness, Leadership and Objective Control characteristics, and it has +1 to hit.",
          "typeId": "9b8f-694b-e5e-b573"
         }
        ]
       },
       {
        "name": "Mercy is Weakness (1CP)",
