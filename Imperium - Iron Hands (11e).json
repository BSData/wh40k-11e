        "characteristics": [
         {
          "name": "Description",
          "$text": "Each time a unit from your army is selected to shoot or fight, you can re-roll one hit roll, one wound roll, OR one damage roll for its attacks. In addition, while a friendly CAANOK VAR or IRON FATHER FEIRROS model is on the battlefield, each such IRON HANDS EPIC HERO projects a 6\" aura: friendly ADEPTUS ASTARTES units within range can re-roll one hit roll, one wound roll, AND one damage roll for their attacks.",
          "typeId": "9b8f-694b-e5e-b573"
         }
        ]
       },
       {
        "name": "Ancient Fury (1CP)",
        "id": "fd80-4131-fec6-9696",
