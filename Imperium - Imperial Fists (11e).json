    "selectionEntries": [
     {
      "name": "Ceramite Sentinels",
      "id": "c728-701a-0091-f9c3",
      "hidden": false,
      "import": true,
      "type": "upgrade",
      "categoryLinks": [
       {
        "name": "Take and Hold",
        "id": "a9f2-30b7-86f3-d504",
        "primary": false,
        "targetId": "1cc1-f11a-4e8f-1bcc"
       }
      ],
      "costs": [
       {
        "name": "Detachment Points",
        "typeId": "82ae-1066-5107-6ae0",
        "value": 2
       }
      ],
      "profiles": [
       {
        "name": "Adaptive Defence",
        "id": "b3fb-7645-b38b-eaae",
        "hidden": false,
        "typeId": "9cc3-6d83-4dd3-9b64",
        "typeName": "Abilities",
        "characteristics": [
         {
          "name": "Description",
          "$text": "All Adeptus Astartes units within terrain areas re-roll wound rolls of 1. Additionally, your units count as Entrenched while they are within a terrain area and have neither been set up this turn nor moved more than 3\". (Darnath Lysander's and Tor Garadon's units are Entrenched all the time, even in the open.)",
          "typeId": "9b8f-694b-e5e-b573"
         }
        ]
       },
       {
        "name": "Augmented Targeting (1CP)",
        "id": "49d0-88e9-c210-b64c",
        "hidden": false,
        "typeId": "9cc3-6d83-4dd3-9b64",
        "typeName": "Abilities",
        "characteristics": [
         {
          "name": "Description",
          "$text": "WHEN: In the Shooting or Fight phase\nTARGET: A friendly unit\nEFFECT: Get your choice of Lethal Hits or Sustained Hits. If Entrenched, get both.",
          "typeId": "9b8f-694b-e5e-b573"
         }
        ]
       },
       {
        "name": "Priority Strike (1CP)",
        "id": "426d-fd05-3769-6f9d",
        "hidden": false,
        "typeId": "9cc3-6d83-4dd3-9b64",
        "typeName": "Abilities",
        "characteristics": [
         {
          "name": "Description",
          "$text": "WHEN: In the Shooting or Fight phase\nTARGET: An Infantry/Mounted unit\nEFFECT: The unit gets +1 to wound a Monster or Vehicle.",
          "typeId": "9b8f-694b-e5e-b573"
         }
        ]
       },
       {
        "name": "Establish Supremacy (1CP)",
        "id": "bb55-53c7-07e4-5886",
        "hidden": false,
        "typeId": "9cc3-6d83-4dd3-9b64",
        "typeName": "Abilities",
        "characteristics": [
         {
          "name": "Description",
          "$text": "WHEN: When an Entrenched unit consolidates in the Fight phase\nTARGET: An Entrenched unit\nEFFECT: The Entrenched unit can make an Objective Consolidation move even if it's locked in combat.",
          "typeId": "9b8f-694b-e5e-b573"
         }
        ]
       },
       {
        "name": "Stand to the End (1CP)",
        "id": "a3ff-d7c2-0f3c-c006",
        "hidden": false,
        "typeId": "9cc3-6d83-4dd3-9b64",
        "typeName": "Abilities",
        "characteristics": [
         {
          "name": "Description",
          "$text": "WHEN: When attacked in the Shooting or Fight phase\nTARGET: A non-Monster/Vehicle unit\nEFFECT: A -1 penalty on wound rolls for attacks with Strength greater than your unit's Toughness; if the unit is Entrenched, a flat -1 on all rolls to wound.",
          "typeId": "9b8f-694b-e5e-b573"
         }
        ]
       },
       {
        "name": "Evasive Repositioning (1CP)",
        "id": "34bb-eb90-323f-e59e",
        "hidden": false,
        "typeId": "9cc3-6d83-4dd3-9b64",
        "typeName": "Abilities",
        "characteristics": [
         {
          "name": "Description",
          "$text": "WHEN: If your unengaged Infantry/Mounted unit loses a wound as a result of shooting\nTARGET: An unengaged Infantry/Mounted unit\nEFFECT: Make a normal move of D6\", or D3+3\" if Entrenched.",
          "typeId": "9b8f-694b-e5e-b573"
         }
        ]
       },
